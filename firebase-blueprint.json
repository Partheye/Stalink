{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public-safe user identity record without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record accessible only by the owning user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified user email address",
          "minLength": 3,
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "ConversationThread": {
      "title": "ConversationThread",
      "description": "A messaging thread owned by a user for offline-first relay syncing.",
      "type": "object",
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "relayPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "prefersSatellite": {
          "type": "boolean"
        },
        "hopCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "threadId",
        "ownerId",
        "name",
        "role",
        "relayPath",
        "prefersSatellite",
        "hopCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "SyncedMessage": {
      "title": "SyncedMessage",
      "description": "A chat message synced after local mesh or offline queuing.",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sender": {
          "type": "string",
          "enum": ["me", "them"],
          "maxLength": 10
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        },
        "timestampLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "dateGroup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "enum": ["queued", "relayed", "delivered", "read"],
          "maxLength": 20
        },
        "transportHint": {
          "type": "string",
          "enum": ["Mesh", "Satellite", "Queue"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "messageId",
        "threadId",
        "ownerId",
        "sender",
        "text",
        "timestampLabel",
        "dateGroup",
        "status",
        "transportHint",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public-safe user profile keyed by Firebase Auth UID."
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII document storing user email, restricted strictly to the owner."
    },
    "/users/{userId}/threads/{threadId}": {
      "schema": { "$ref": "#/entities/ConversationThread" },
      "description": "User-owned conversation threads for synced offline/mesh chat."
    },
    "/users/{userId}/threads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/SyncedMessage" },
      "description": "Messages inside a user-owned conversation thread."
    }
  }
}
