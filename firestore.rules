rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'createdAt', 'updatedAt']) &&
        data.uid == request.auth.uid &&
        data.uid == userId &&
        isValidId(data.uid) &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.uid == request.auth.uid &&
        data.uid == userId &&
        isValidId(data.uid) &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConversationThread(data, userId, threadId) {
      return data.keys().hasAll([
          'threadId', 'ownerId', 'name', 'role', 'relayPath',
          'prefersSatellite', 'hopCount', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'threadId', 'ownerId', 'name', 'role', 'relayPath',
          'prefersSatellite', 'hopCount', 'createdAt', 'updatedAt'
        ]) &&
        data.threadId == threadId &&
        isValidId(data.threadId) &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        isValidId(data.ownerId) &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 120 &&
        data.role is string &&
        data.role.size() >= 1 &&
        data.role.size() <= 120 &&
        data.relayPath is string &&
        data.relayPath.size() >= 1 &&
        data.relayPath.size() <= 120 &&
        data.prefersSatellite is bool &&
        data.hopCount is int &&
        data.hopCount >= 0 &&
        data.hopCount <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSyncedMessage(data, userId, threadId, messageId) {
      return data.keys().hasAll([
          'messageId', 'threadId', 'ownerId', 'sender', 'text',
          'timestampLabel', 'dateGroup', 'status', 'transportHint',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'messageId', 'threadId', 'ownerId', 'sender', 'text',
          'timestampLabel', 'dateGroup', 'status', 'transportHint',
          'createdAt', 'updatedAt'
        ]) &&
        data.messageId == messageId &&
        isValidId(data.messageId) &&
        data.threadId == threadId &&
        isValidId(data.threadId) &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        isValidId(data.ownerId) &&
        data.sender is string &&
        data.sender.size() <= 10 &&
        data.sender in ['me', 'them'] &&
        data.text is string &&
        data.text.size() <= 4000 &&
        data.timestampLabel is string &&
        data.timestampLabel.size() >= 1 &&
        data.timestampLabel.size() <= 32 &&
        data.dateGroup is string &&
        data.dateGroup.size() >= 1 &&
        data.dateGroup.size() <= 32 &&
        data.status is string &&
        data.status.size() <= 20 &&
        data.status in ['queued', 'relayed', 'delivered', 'read'] &&
        data.transportHint is string &&
        data.transportHint.size() <= 20 &&
        data.transportHint in ['Mesh', 'Satellite', 'Queue'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if false;

      match /private/info {
        allow get: if isValidId(userId) && isOwner(userId);
        allow list: if false;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isOwner(userId) &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isOwner(userId) &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if false;
      }

      match /threads/{threadId} {
        allow get: if isValidId(userId) && isValidId(threadId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(threadId) &&
          isOwner(userId) &&
          isValidConversationThread(incoming(), userId, threadId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(threadId) &&
          isOwner(userId) &&
          isValidConversationThread(incoming(), userId, threadId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().threadId == existing().threadId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'role', 'relayPath', 'prefersSatellite', 'hopCount', 'updatedAt'
          ]);
        allow delete: if false;

        match /messages/{messageId} {
          allow get: if isValidId(userId) &&
            isValidId(threadId) &&
            isValidId(messageId) &&
            isOwner(userId) &&
            exists(/databases/$(database)/documents/users/$(userId)/threads/$(threadId));
          allow list: if isValidId(userId) &&
            isValidId(threadId) &&
            isOwner(userId) &&
            existing().ownerId == request.auth.uid &&
            existing().threadId == threadId;
          allow create: if isVerifiedUser() &&
            isValidId(userId) &&
            isValidId(threadId) &&
            isValidId(messageId) &&
            isOwner(userId) &&
            isValidSyncedMessage(incoming(), userId, threadId, messageId) &&
            incoming().createdAt == request.time &&
            incoming().updatedAt == request.time &&
            existsAfter(/databases/$(database)/documents/users/$(userId)/threads/$(threadId)) &&
            getAfter(/databases/$(database)/documents/users/$(userId)/threads/$(threadId)).data.ownerId == request.auth.uid;
          allow update: if isVerifiedUser() &&
            isValidId(userId) &&
            isValidId(threadId) &&
            isValidId(messageId) &&
            isOwner(userId) &&
            isValidSyncedMessage(incoming(), userId, threadId, messageId) &&
            existing().status != 'read' &&
            incoming().ownerId == existing().ownerId &&
            incoming().threadId == existing().threadId &&
            incoming().messageId == existing().messageId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'transportHint', 'updatedAt'
            ]);
          allow delete: if false;
        }
      }
    }
  }
}
